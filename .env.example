# Runtime configuration for den-atlas. Every variable is optional. The binary reads the process
# environment only (no .env loader): export these for `cargo run`; on the homelab they come from
# /etc/den/env/den-atlas.env. Atlas serves one public, derived, non-personal dataset — METRICS_TOKEN is
# the only secret.

# The port to listen on (default 8080).
# PORT=8080

# Where the dataset blobs + dataset.meta.json live (default ./data, populated by scripts/fetch-dataset.sh;
# the image sets /app/data).
# DATA_DIR=data

# Force the origin used in the descriptor's absolute blob URLs. Unset derives it from
# X-Forwarded-Proto/X-Forwarded-Host/Host — set it only to point blob downloads at a CDN in front.
# PUBLIC_BASE_URL=https://atlas.example.com

# JustWatch "most popular" catalog rows (public, tokenless — the endpoint is unauthenticated).
# These are the OPERATOR DEFAULT only: each install picks its own region + providers at /configure
# (a <region>_<codes> URL segment), and `auto` installs take the country the Den app forwards. A plain
# …/manifest.json install (no config segment) falls back to these.
# JW_COUNTRY=US                       # default ISO country when an install forwards none (region=auto)
# JW_PROVIDERS=nfx,max,amp,dnp,atp    # default provider subset for a config-less install (default: all)
# JW_CACHE_TTL_SECS=21600             # in-process freshness for trending rows (default 6h)

# den-embed base URL for the POST /embed search proxy. Unset ⇒ /embed answers 503.
# EMBED_URL=http://den-embed:8080

# Bearer token for GET /metrics (Prometheus text). Unset or empty ⇒ the route answers 404.
# METRICS_TOKEN=
