# Copy to .env for local `npm run dev` (gitignored). Atlas holds NO secrets — it serves one public,
# derived, non-personal dataset. These vars only tune runtime behavior.

# PORT=8080

# Where the dataset blobs + dataset.meta.json live (default ./data, populated by `npm run import`).
# ATLAS_DATA_DIR=data

# Force the origin used in the descriptor's absolute blob URLs. Leave unset to derive it from
# X-Forwarded-Proto/Host (behind Caddy) — set it only to point blob downloads at a CDN in front.
# PUBLIC_BASE_URL=https://atlas.example.com

# JustWatch "most popular" catalog rows (public, tokenless). No secret — the endpoint is unauthenticated.
# JW_COUNTRY=US                       # ISO country for trending
# JW_PROVIDERS=nfx,max,amp,dnp,atp    # subset of the known provider codes (default: all)
# JW_CACHE_TTL_SECS=21600             # in-process freshness for trending rows (default 6h)

# Import overrides (see scripts/import-dataset.mjs) — bump when a new version is published.
# DEN_REPO=../den
# ATLAS_TAXONOMY=t01
# ATLAS_EMBEDDING=e02
